{
  "$meta": {
    "name": "Saudi Leadership Society — Design Tokens",
    "version": "1.0.0",
    "owner": "SLS Program / Misk Foundation",
    "provenance": {
      "status": "INFERRED — NOT EXTRACTED FROM THE LIVE SITE",
      "reason": "The build environment's network egress policy blocked every misk.org.sa host (hub.misk.org.sa, brand.misk.org.sa, content.cdnhub.misk.org.sa) with HTTP 403 at the proxy, so the live page's computed CSS and the Impact Report PDF could not be read.",
      "howToFix": "See docs/DESIGN_TOKENS_REPORT.md. Replace the hex values in `color` below with the real ones; every colour in the app and in PDF exports reads from this file at runtime, so no rebuild is required.",
      "verified": [],
      "inferred": ["color.*", "font.*", "radius.*", "shadow.*", "space.*"]
    },
    "chartPaletteValidation": {
      "tool": "dataviz/scripts/validate_palette.js",
      "categorical6_light_adjacent": "PASS lightness, PASS chroma, PASS CVD (worst adjacent dE 11.3 protan), PASS normal-vision (worst dE 20.5), WARN contrast for gold #C98500 (2.99:1) and magenta #E87BA4 (2.62:1)",
      "pillars3_light_allPairs": "PASS lightness, PASS chroma, PASS CVD (worst dE 11.3 protan), PASS normal-vision (worst dE 19.3), WARN contrast for gold #C98500",
      "reliefApplied": "Charts ship a legend for >=2 series, selective direct labels, a 2px surface gap between adjacent/stacked fills, and a 'Table' toggle on every chart — which is the relief the contrast WARN requires.",
      "seriesCap": 6,
      "overflowRule": "A 7th series folds into 'Other' (color.chart.other) or the view facets. Hues are assigned in fixed slot order and are never cycled or regenerated."
    }
  },

  "color": {
