        "#12A085",
        "#C98500",
        "#2A78D6",
        "#EB6834",
        "#4A3AA7",
        "#E87BA4"
      ],
      "categoricalNames": ["teal", "gold", "blue", "orange", "violet", "magenta"],
      "other": "#6B7C77",
      "sequential": ["#E3F5F0", "#B9E3D8", "#7FCBB9", "#40B29A", "#12A085", "#0B7361"],
